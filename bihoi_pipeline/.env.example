# Copy to .env; paths are resolved by the launcher. No credentials are shipped.
# Leave these unset for repository-local defaults:
# HOI_DATA_ROOT=/absolute/path/to/operator-data
# HOI_MODEL_ROOT=/absolute/path/to/model-files
# HOI_CALIBRATION_DIR=/absolute/path/to/rig-calibration
# HOI_ENV_ROOT=/absolute/path/to/isolated-conda-prefixes
# CONDA_EXE=/absolute/path/to/miniforge3/bin/conda
# CONDA_SH=/absolute/path/to/miniforge3/etc/profile.d/conda.sh
# Individual environments may override the root, e.g. HOI_ENV_WILOR=/path/to/wilor
WEBUI_ALLOWED_GPUS=all
WEBUI_PARALLEL_DATASETS=0
WEBUI_CPU_PARALLEL=3
WEBUI_VRAM_PER_STEP_MB=32768
WEBUI_HOST=127.0.0.1
WEBUI_PORT=7860
WEBUI_SHARE=0
WEBUI_NO_AUTH=0
WEBUI_USER=operator
# Set locally. An unset password generates an ephemeral password printed at launch.
# WEBUI_PASSWORD=replace-with-your-own-password
# HOI_ALLOWED_DATA_ROOTS=/extra/path/one:/extra/path/two
# Per-native-environment CUDA_HOME overrides, matching torch's compiled CUDA:
# HOI_CUDA_HOME_SAM3D_OBJECTS=/path/to/cuda-12.1
# HOI_CUDA_HOME_FOUNDATIONPOSE=/path/to/cuda-12.4
# HOI_CUDA_HOME_HOCAP_ANNOTATION=/path/to/cuda-11.8

# Separate per-person hand calibration inputs and private FMHR assets:
# HOI_HAND_CALIBRATION_ROOT=/absolute/path/to/calibration-captures
# Default capture path: $HOI_DATA_ROOT/hand_calibration/<data_name>/
# HOI_FMHR_MODEL_DIR=/absolute/path/to/private-fmhr-models
# Contains gcn_left.pth, gcn_right.pth, TEMPLATE_LEFT.obj, TEMPLATE_RIGHT.obj

# WAPR uses the patched source bundled with this repository.
# HOI_ENV_WAPR=/absolute/path/to/wapr-environment
# HOI_ENV_FOUNDATIONPOSE=/absolute/path/to/foundationpose-environment
# HOI_CUDA_HOME_WAPR=/path/to/cuda-12.8
# WAPR_CACHE_DIR=/absolute/path/to/wapr-model-and-native-cache
# Optional standalone MoSE3 demo (install its upstream dependencies separately):
# HOI_ENV_MOSE3=/absolute/path/to/mose3-environment
# MOSE3_REPO=/absolute/path/to/MoSE3
# MOSE3_CHECKPOINT=/absolute/path/to/MoSE3-checkpoint
